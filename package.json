{
	"name": "nest-zoomon-api",
	"private": true,
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --env-file .env.development --watch -- -b swc",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"test": "jest --passWithNoTests",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"prepare": "husky",
		"commit": "cz",
		"docker:mongo:dev": "docker run --name zoomondb-rs -d -p 27017:27017 mongo  mongod --replSet rs0 --bind_ip_all",
		"docker:mongo:dev:initial:replica": "docker exec zoomondb-rs mongosh --eval \"rs.initiate()\"",
		"docker:mongo:dev:verify:replica": "docker exec -it zoomondb-rs mongosh --eval \"rs.status().ok\"",
		"docker:mongo:dev:reconfig:replica:host": "docker exec -it zoomondb-rs mongosh --eval \"rs.initiate({_id:'rs0',members:[{_id:0,host:'127.0.0.1:27017'}]})\"",
		"docker:mongo:dev:verify:replica:host": "docker exec -it mongo-rs mongosh --eval \"rs.conf().members\"",
		"docker:minio": "docker run -d --name minio -p 9000:9000 -p 9001:9001 -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin123 -v minio-data:/data quay.io/minio/minio:latest server /data --console-address \": 9001\""
	},
	"dependencies": {
		"@casl/ability": "^6.8.1",
		"@casl/mongoose": "^8.0.5",
		"@nestjs-modules/ioredis": "^2.2.1",
		"@nestjs/bullmq": "^11.0.4",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.0.1",
		"@nestjs/event-emitter": "^3.1.0",
		"@nestjs/mapped-types": "^2.1.1",
		"@nestjs/mongoose": "^11.0.4",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/schedule": "^6.1.3",
		"bullmq": "^5.76.4",
		"clamscan": "^2.4.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"compression": "^1.8.1",
		"connect-mongo": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"csrf-csrf": "^4.0.3",
		"express-session": "^1.19.0",
		"fast-json-patch": "^3.1.1",
		"file-type": "^22.0.1",
		"helmet": "^8.1.0",
		"install": "^0.13.0",
		"ioredis": "^5.10.1",
		"minio": "^8.0.7",
		"mongoose": "^9.4.1",
		"multer": "^2.1.1",
		"qs": "^6.15.1",
		"reading-time": "^1.5.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"sanitize-html": "^2.17.3",
		"sharp": "^0.34.5",
		"slugify": "^1.6.9",
		"uuid": "^14.0.0",
		"zod": "^4.3.6",
		"zod-validation-error": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/clamscan": "^2.4.1",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/jest": "^30.0.0",
		"@types/mongodb": "^4.0.6",
		"@types/multer": "^2.1.0",
		"@types/node": "^24.0.0",
		"@types/qs": "^6.15.0",
		"@types/sanitize-html": "^2.16.1",
		"@types/supertest": "^7.0.0",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^17.0.0",
		"husky": "^9.1.7",
		"jest": "^30.0.0",
		"lint-staged": "^16.4.0",
		"prettier": "^3.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
